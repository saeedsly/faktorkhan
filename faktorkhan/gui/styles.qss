/* فاکتورخوان — تم گرافیک حرفه‌ای (Dark Theme) */
QMainWindow {
    background-color: #0b1120;
}
QWidget {
    color: #e2e8f0;
    font-size: 13px;
    font-family: "Segoe UI", "Vazirmatn", "Tahoma", "Arial", sans-serif;
}
QLabel {
    color: #cbd5e1;
}
QLabel#brand {
    font-size: 20px;
    font-weight: bold;
    color: #38bdf8;
    padding: 12px;
}
QLabel#statusOk {
    color: #22c55e;
    font-weight: bold;
}
QLabel#statusBad {
    color: #ef4444;
    font-weight: bold;
}
QLabel#statusWarn {
    color: #f59e0b;
    font-weight: bold;
}
QPushButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 32px;
}
QPushButton:hover {
    background-color: #3b82f6;
}
QPushButton:pressed {
    background-color: #1d4ed8;
}
QPushButton:disabled {
    background-color: #475569;
    color: #94a3b8;
}
QPushButton#ghost {
    background-color: transparent;
    border: 1px solid #334155;
}
QPushButton#ghost:hover {
    background-color: #1e293b;
}
QPushButton#danger {
    background-color: #b91c1c;
}
QPushButton#danger:hover {
    background-color: #ef4444;
}
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 6px 8px;
    color: #e2e8f0;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #2563eb;
}
QTableWidget {
    background-color: #1e293b;
    gridline-color: #334155;
    border: 1px solid #334155;
    selection-background-color: #2563eb;
}
QTableWidget::item {
    padding: 6px;
    border: none;
}
QHeaderView::section {
    background-color: #0f172a;
    color: #94a3b8;
    padding: 6px;
    border: none;
    font-weight: bold;
}
QListWidget {
    background-color: #0b1120;
    border: none;
    outline: none;
}
QListWidget::item {
    padding: 12px 16px;
    border-bottom: 1px solid #111827;
    color: #94a3b8;
}
QListWidget::item:selected {
    background-color: #1e3a8a;
    color: #ffffff;
    border-left: 4px solid #38bdf8;
}
QListWidget::item:hover:!selected {
    background-color: #1e293b;
    color: #e2e8f0;
}
QStackedWidget {
    background-color: #0b1120;
}
QFrame#card {
    background-color: #111827;
    border: 1px solid #1f2937;
    border-radius: 8px;
}
QScrollArea {
    border: none;
    background-color: transparent;
}
QProgressBar {
    border: 1px solid #334155;
    border-radius: 4px;
    text-align: center;
    color: #e2e8f0;
    background-color: #1e293b;
}
QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}
QMessageBox {
    background-color: #0b1120;
}
