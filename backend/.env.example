# ────────────────────────────────────────────────────────────────
#  فاکتورخوان — تنظیمات محیطی
#  این فایل را به .env کپی کنید و مقادیر را تغییر دهید.
#  هشدار: فایل .env را هرگز در مخزن گیت قرار ندهید.
#
#  ساده‌ترین راه ساخت این فایل برای سرور:
#      SETUP-MYSQL-WINDOWS.bat      (ویندوز + WAMP/MySQL)
# ────────────────────────────────────────────────────────────────

APP_NAME=فاکتورخوان
# production = سخت‌گیرانه برای اینترنت   |   desktop = نسخه رومیزی
APP_ENV=production

# ── امنیت (در سرور اجباری) ────────────────────────────────────
# با دستور زیر بسازید:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# اگر خالی بماند، به‌صورت خودکار در storage/.secret_key ساخته و پایدار می‌شود.
SECRET_KEY=
ENCRYPTION_KEY=
TOKEN_TTL_HOURS=168
MAX_LOGIN_ATTEMPTS=7
LOCK_MINUTES=15

# ── دامنه و HTTPS (برای انتشار روی اینترنت) ───────────────────
# فهرست دامنه‌های مجاز؛ حملات Host header را می‌بندد.
# نمونه: ALLOWED_HOSTS=faktorkhan.ir,www.faktorkhan.ir
ALLOWED_HOSTS=
# اگر سایت پشت HTTPS است ۱ بگذارید تا هدر HSTS ارسال شود.
FORCE_HTTPS=0
HSTS_SECONDS=31536000
# مستندات API در production به‌صورت پیش‌فرض بسته است.
ENABLE_API_DOCS=0
# پشت Apache/nginx: هدرهای X-Forwarded-* باور شوند (IP واقعی کاربر).
PROXY_HEADERS=0
FORWARDED_ALLOW_IPS=127.0.0.1

# ── پایگاه داده ───────────────────────────────────────────────
# MySQL (WAMP/XAMPP):   mysql+pymysql://faktorkhan:pass@127.0.0.1:3306/faktorkhan?charset=utf8mb4
# MariaDB:              mariadb+pymysql://user:pass@127.0.0.1:3306/faktorkhan?charset=utf8mb4
# SQLite (پیش‌فرض):      خالی بگذارید
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── سرویس ابری (فقط سمت سرور، هرگز به مرورگر فرستاده نمی‌شود) ─
# آدرس درگاه سرویس ابری را اینجا و فقط اینجا قرار دهید.
CLOUD_OCR_GATEWAY=
CLOUD_OCR_TIMEOUT=180
CLOUD_OCR_VERIFY_TLS=true
# توکن اولیه (اختیاری)؛ بهتر است از پنل مدیریت ثبت شود تا رمزنگاری بماند.
CLOUD_OCR_SEED_TOKEN=

# ── ثبت‌نام و اشتراک ──────────────────────────────────────────
# روی سرور اینترنتی، ثبت‌نام آزاد را خاموش کنید (false) و لایسنس بفروشید.
ALLOW_REGISTRATION=false
REQUIRE_LICENSE=true
TRIAL_DAYS=14
TRIAL_PAGES=50

# ── حساب مالک (اولین اجرا) ────────────────────────────────────
OWNER_NAME=سعید سالاری
OWNER_EMAIL=owner@faktorkhan.local
OWNER_PASSWORD=

# ── اجرا و ذخیره‌سازی ─────────────────────────────────────────
# 0.0.0.0 = برای شبکه/سرور قابل دسترس است   |   127.0.0.1 = فقط همین سیستم
HOST=0.0.0.0
PORT=8000
# خالی = پوشه storage در ریشه پروژه
DATA_DIR=
MAX_UPLOAD_MB=25
# در production مقدار * نادیده گرفته می‌شود (همان‌مبدأ).
CORS_ORIGINS=*
